{
  "name": "@local/nodejs-pattern",
  "version": "0.1.0",
  "private": true,
  "description": "Nx generator for a TypeScript Node.js web application with a Hello World page",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "generators": "./generators.json",
  "files": [
    "dist",
    "generators.json",
    "src/generators/*/schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nx/devkit": ">=23.0.0 <24.0.0"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@nx/devkit": "23.3.2",
    "@types/node": "^24.0.0",
    "nx": "23.3.2",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
